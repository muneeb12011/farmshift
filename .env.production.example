# Copy to .env.production (or run: npm run init:prod -- your.domain.com) and fill in.
DOMAIN=farmshift.example.com

# REQUIRED: >= 32 chars. Generated for you by `npm run init:prod`.
JWT_SECRET=
# Protects GET /metrics (not publicly routed; for Prometheus on the same host/network).
METRICS_TOKEN=

# Real satellite data (no API keys needed for NASA POWER or MODIS)
ENV_PROVIDER=auto
NDVI_ENABLED=true

# OPTIONAL: set to enable AI-written explanations ("narration":"llm"). Get one at console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

RUN_RETENTION_DAYS=30

# ---- email for password reset (any SMTP provider: SendGrid, Mailgun, Postmark, Amazon SES, Gmail app password...) ----
# Without SMTP_URL in production, reset emails cannot be delivered (the API logs an error and still answers 202).
SMTP_URL=
MAIL_FROM=FarmShift <no-reply@farmshift.example.com>
# Public address of the web app (used in the reset link). Normally https://<DOMAIN>
APP_URL=https://farmshift.example.com

# ---- optional: PostgreSQL (see docker-compose.postgres.yml) ----
POSTGRES_PASSWORD=
# DATABASE_URL=postgres://user:pass@host:5432/dbname   # for a managed database instead of the bundled one
# DATABASE_SSL=true
