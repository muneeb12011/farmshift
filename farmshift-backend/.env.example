# ---- server ----
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# ---- storage (SQLite file; use :memory: for throwaway runs) ----
DATABASE_PATH=./data/farmshift.db

# ---- auth: REQUIRED in production, >= 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- database ----
# Leave DATABASE_URL empty to use the SQLite file above (single instance).
# Set it to use PostgreSQL (multiple instances, managed backups):  postgres://user:pass@host:5432/farmshift
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SCHEMA=public

# ---- email (password reset) ----
# smtps://user:pass@smtp.provider.com:465 . Leave empty in development: the reset link is printed in the API log instead.
SMTP_URL=
MAIL_FROM=FarmShift <no-reply@localhost>
APP_URL=http://localhost:3000

# ---- web ----
# Comma-separated list of allowed browser origins (your Next.js app)
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=240

# ---- environmental data ----
# auto      NASA POWER -> stale cache -> labelled synthetic fallback (recommended)
# nasa      real data only; upstream failure returns 502 (never fabricates)
# synthetic offline demo / tests; every response is labelled "not observed"
ENV_PROVIDER=auto
NDVI_ENABLED=true
NDVI_YEARS=2
CLIMATE_YEARS=5
UPSTREAM_TIMEOUT_MS=25000
ENV_CACHE_TTL_HOURS=12

# ---- optional: LLM rewrite of explanations (numbers always come from the engine) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
