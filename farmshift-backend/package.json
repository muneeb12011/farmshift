{
  "name": "farmshift-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FarmShift API: satellite-derived environmental data and agronomic crop-rotation scenario engine",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup": "tsx --env-file-if-exists=.env src/cli/backup.ts",
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/cli/seed.ts",
    "smoke:live": "tsx --env-file-if-exists=.env scripts/smoke-live.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.0",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^7.0.13",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
